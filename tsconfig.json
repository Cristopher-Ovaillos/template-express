{
  "compilerOptions": {
    "target": "es2022", //esnext es la version por defecto, pero se usa es2022 | con esnext tendriamos las caracteristicas nuevas, pero puede volver imcompattible si se actualiza la version
    "module": "nodenext",
    "paths":{
      "@/*": ["./src/*"],
      "@core/*": ["./src/core/*"],
      "@modules/*": ["./src/modules/*"],
      "@config/*": ["./src/config/*"],
      "@loaders/*": ["./src/loaders/*"],
    },
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  }
}